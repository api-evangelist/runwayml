{
  "opencollection": "1.0.0",
  "info": {
    "name": "Runway Character Performance Organization API",
    "version": "2024-11-06"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get organization usage and credit balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dev.runwayml.com/v1/organization"
          },
          "docs": "Return the usage tier and remaining credit balance for the organization tied to the API key."
        }
      ]
    }
  ],
  "bundled": true
}